# ---------------------------------------------------------------------------
# Muse configuration. Copy to .env and fill in the values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Web UI password (minimum 8 characters). There is exactly one user: you.
APP_PASSWORD=change-me-please

# Signing key for session cookies. If empty, one is derived from APP_PASSWORD.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Set to true only when Muse is served over HTTPS.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Optional: point at an OpenAI-compatible gateway.
OPENAI_BASE_URL=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024

# Identify this client to gateways. OpenCode Go asks for a non-generic user agent.
OPENAI_USER_AGENT=Muse/0.1.0
# Optional per-conversation session header (OpenCode Go: x-opencode-session).
OPENAI_SESSION_HEADER=
# Optional separate image provider. OpenCode Go is text-only, so images need
# OpenAI or the OpenCode pay-as-you-go Console.
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_API_KEY=

# ---------------------------------------------------------------------------
# OpenCode Go preset (optional)
#   1. Subscribe to Go in the OpenCode Console and copy the API key.
#   2. Use these values instead of the OpenAI defaults above.
# ---------------------------------------------------------------------------
# OPENAI_BASE_URL=https://opencode.ai/inference/go/openai/v1
# OPENAI_API_KEY=<your OpenCode Go API key>
# OPENAI_TEXT_MODEL=deepseek-v4.1-flash
# OPENAI_SESSION_HEADER=x-opencode-session
# Images (Go does not include image models):
# OPENAI_IMAGE_BASE_URL=https://opencode.ai/inference/openai/v1
# OPENAI_IMAGE_API_KEY=<your OpenAI or OpenCode Console key>
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# ---------------------------------------------------------------------------
# Storage & behaviour
# ---------------------------------------------------------------------------
# Storage. In Docker this is forced to /data by the Dockerfile, so leave this
# commented out there. Uncomment for a local (non-Docker) override.
# DATA_DIR=./data
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
# 0 = no fixed model-round limit. Set a positive number for an optional cap.
MAX_AGENT_STEPS=0
# Wall-clock safety for one agent run. 0 disables it.
AGENT_RUN_TIMEOUT_SECONDS=900

# Named agent team. Auto-run claims queued team tasks in the background.
TEAM_ENABLED=true
TEAM_AUTO_RUN=true
TEAM_TICK_SECONDS=2
TEAM_MAX_CONCURRENT=2
TEAM_MAX_AGENTS=16
TEAM_MAX_DEPTH=3

# Vault auto-locks after this many seconds of inactivity.
VAULT_IDLE_LOCK_SECONDS=900

# Optional shell tool. Disabled by default; every command requires approval.
# /workspace is backed by the muse-workspace Docker volume.
SHELL_ENABLED=false
SHELL_WORKSPACE_DIR=/workspace
SHELL_TIMEOUT_SECONDS=60

# Sentinel defaults (can also be changed in the UI).
WRITE_ENABLED=true
AUTO_APPROVE_WRITES=false

# ---------------------------------------------------------------------------
# Browser sandbox
# ---------------------------------------------------------------------------
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
# Comma-separated allowlist. Empty means "any public website".
# Private / loopback / link-local addresses are always blocked.
BROWSER_ALLOWED_DOMAINS=
# Never enable this outside tests: allows the browser to reach private IPs.
BROWSER_ALLOW_PRIVATE_NETWORKS=false
# CORS compatibility for third-party pages inside the sandbox.
# off = normal Chromium; inject = add CORS headers only for listed domains.
# Example: BROWSER_CORS_MODE=inject
#          BROWSER_CORS_DOMAINS=github.com,githubusercontent.com,githubassets.com
BROWSER_CORS_MODE=off
BROWSER_CORS_DOMAINS=
# When using inject mode, blocking service workers prevents them from bypassing
# Playwright response-header interception. This can affect offline/PWA features.
BROWSER_BLOCK_SERVICE_WORKERS=false
# Optional external Chromium instance (CDP) and its live noVNC view.
# BROWSER_CDP_URL=http://browser:9223
# BROWSER_VNC_URL=http://127.0.0.1:6080/vnc.html?autoconnect=1&resize=scale&reconnect=1
BROWSER_CDP_URL=
BROWSER_VNC_URL=
# Extra origins allowed in the browser iframe CSP, comma- or space-separated.
# The origin from BROWSER_VNC_URL is added automatically.
CSP_FRAME_SRC=
